<mujoco model="scene outrun">
  <compiler texturedir="assets/textures"/>


  <visual>
      <headlight diffuse=".6 .6 .6" ambient=".3 .3 .3" specular="0 0 0"/>
      <rgba haze=".3 .3 .3 1"/>
      <global azimuth="90" elevation="-10"/>
  </visual>


  <asset>
    <!-- sky color -->
    <texture name="skybox" type="skybox" builtin="gradient" rgb1=".005 .005 .005" rgb2=".005 .005 .005"
             width="800" height="800"/>

    <!-- ground plane texture-->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1=".9 .9 .9" rgb2=".7 .7 .7"
             markrgb="0.2 0.2 0.2" width="100" height="100"/>

    <!-- ground plane material -->
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="20 20" reflectance=".2"/>
  </asset>

  <worldbody>
    <!-- adding floor -->
    <body name="floor">
      <geom name="floor" condim="3" contype="1" conaffinity="1" friction="0.001" size="0 0 .2" type="plane" material="groundplane"/>
    </body>
  </worldbody>

</mujoco>
